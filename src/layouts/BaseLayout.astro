---
import { Font } from 'astro:assets';
import PrefsScript from '../components/PrefsScript.astro';
import PageTransitions from '../components/PageTransitions.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Palette } from '../components/Palette';
import { Toast } from '../components/Toast';
import { getSingleton } from '../utils/content';
import { site, type PageKey } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  current?: PageKey;
  /** The Open Graph image, from /og/[slug].png. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** Keeps the page out of search results and the sitemap's canonical set (the 404). */
  noindex?: boolean;
  /** The page opens on a full-screen hero (home): the header starts out transparent over it. */
  overHero?: boolean;
}

const profile = await getSingleton('profile');
const {
  title = site.title,
  description = profile.lead,
  current,
  image = '/og/home.png',
  imageAlt = `${profile.name}: ${profile.og.tagline}`,
  type = 'website',
  noindex = false,
  overHero = false,
} = Astro.props;
const { email } = profile;
// build.format 'file' reports built paths as /work/x.html and /index.html; canonicals use the clean URL.
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <PrefsScript />
    <PageTransitions />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <meta name="theme-color" content="#DDE1EC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#070B1A" media="(prefers-color-scheme: dark)" />
    <Font cssVariable="--font-big-shoulders" preload />
    <Font cssVariable="--font-space-mono" preload />
    <Font cssVariable="--font-atkinson" preload={[{ style: 'normal' }]} />
  </head>
  <body>
    {/* The hand-drawn wobble that doodles share (the logo's own, see LogoMark.astro) */}
    <svg class="absolute size-0" aria-hidden="true" focusable="false">
      <filter id="rough" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" scale="2.6"></feDisplacementMap>
      </filter>
    </svg>
    <Header current={current} overHero={overHero} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <Palette />
    <Toast />
    <script is:inline define:vars={{ email }}>
      console.log(
        '%cReading my source? We should talk. I also do 1:1s.',
        'font:700 14px system-ui;color:#C4461C',
      );
      console.log(`${email} · Try ⌘K.`);
    </script>
  </body>
</html>
