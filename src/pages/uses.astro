---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSingleton } from '../utils/content';
import { site } from '../data/site';

const uses = await getSingleton('uses');
---

<BaseLayout title={`Uses · ${site.name}`} description={uses.lead} current="uses">
  <div class="mx-auto grid max-w-260 gap-9 px-gutter pt-14 pb-24">
    <div class="grid gap-3.5">
      <h1 class="text-page-title font-extrabold">Uses</h1>
      <p class="text-page-lead text-ink3">{uses.lead}</p>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {uses.groups.map((g) => (
        <section class="grid content-start gap-3.5 rounded-card border bg-surface p-6">
          <h2 class="text-card-title font-bold">{g.title}</h2>
          <ul>
            {g.items.map((item) => (
              <li class="flex items-baseline justify-between gap-3 border-t border-sunken py-2.5">
                <b>{item.name}</b>
                {item.links ? (
                  <span class="text-right">
                    {item.links.map((l, i) => (
                      <>
                        {i > 0 && <span class="text-ink2"> + </span>}
                        <a href={l.url}>{l.text}</a>
                      </>
                    ))}
                  </span>
                ) : item.url ? (
                  <a class="text-right" href={item.url}>
                    {item.note}
                  </a>
                ) : (
                  item.note && <span class="text-right text-accent">{item.note}</span>
                )}
                {item.draft && <span class="text-xs font-bold text-accent print:hidden">Draft</span>}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
