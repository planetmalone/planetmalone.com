---
/** "Skip to content": the first focusable element on every page, hidden until focused. */
interface Props {
  target?: string;
}

const { target = '#main' } = Astro.props;
---

<a
  class:list={[
    // Hidden until focused
    'sr-only focus:not-sr-only',
    'focus:absolute focus:top-2 focus:left-4 focus:z-50 focus:px-4 focus:py-2.5',
    'rounded-pill bg-btn font-bold text-btn-ink no-underline print:hidden',
  ]}
  href={target}
>
  Skip to content
</a>
