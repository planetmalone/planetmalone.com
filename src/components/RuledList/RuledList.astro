---
/**
 * Label / value rows between rules (Colophon). A row can have a value, a
 * draft, or both.
 */
import { Draft } from '../Draft';

interface Props {
  rows: { label: string; value?: string | undefined; draft?: string | undefined }[];
}

const { rows }: Props = Astro.props;
---

<dl class="grid border-t border-ink">
  {rows.map((r) => (
    <div class="grid gap-x-6 gap-y-2 border-b py-4.5 md:grid-cols-[180px_minmax(0,1fr)]">
      <dt class="text-row font-bold">{r.label}</dt>
      <dd class="grid gap-2.5">
        {r.value && <p class="text-row/[1.6] text-ink3">{r.value}</p>}
        {r.draft && <Draft size="sm">{r.draft}</Draft>}
      </dd>
    </div>
  ))}
</dl>
