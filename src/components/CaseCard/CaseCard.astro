---
/**
 * A case-study card on the home page. The title link stretches over the whole
 * card, so the card is one click target but its accessible name stays short.
 * The title morphs into the case study's H1 (see PageTransitions.astro).
 */
import type { CollectionEntry } from 'astro:content';
import { Chip } from '../Chip';
import { formatYearsCompact } from '../../utils/format';

interface Props {
  entry: CollectionEntry<'cases'>;
}

const { id, data } = Astro.props.entry;
---

<article
  class:list={[
    'relative flex flex-col gap-3 rounded-card border bg-surface p-6',
    'transition-colors duration-150 hover:border-accent',
    'has-[a:focus-visible]:outline-3 has-[a:focus-visible]:outline-offset-3 has-[a:focus-visible]:outline-accent',
  ]}
>
  <ul class="flex flex-wrap gap-1.5" aria-label="Tags">
    {data.tags.map((t) => (
      <Chip as="li">{t}</Chip>
    ))}
  </ul>
  <h3 class="text-card-title font-bold text-pretty" data-vt-case={id}>
    <a
      class="text-ink no-underline after:absolute after:inset-0 after:rounded-card focus-visible:outline-none"
      href={`/work/${id}`}
    >
      {data.title}
    </a>
  </h3>
  <p class="text-sm text-ink2">
    {data.company} · {formatYearsCompact(data.years)}
  </p>
  <p class="text-base/normal text-ink3">{data.summary}</p>
  <p class="mt-auto flex items-baseline justify-between gap-3 border-t border-dashed pt-3.5">
    <span class="font-bold text-green tabular-nums">{data.metric}</span>
    <span class="text-ui font-bold whitespace-nowrap text-accent" aria-hidden="true">
      Read →
    </span>
  </p>
</article>
