---
/**
 * Home hero: a full screen of deep space with a status readout (and Planet
 * Malone's local time), name and lead, over the curve of the planet's horizon,
 * which hints there's more below. It slides up under the header, which stays
 * transparent until the horizon has cleared it, then turns to glass
 * (./pmHorizon.ts). As you scroll, the words fade away (where the browser supports scroll-driven
 * animations, and only with Motion on).
 */
import { Clock } from '../Clock';
import { Starfield } from '../Starfield';
import { getSingleton } from '../../utils/content';

const profile = await getSingleton('profile');

// The horizon ellipse: twice the hero's width, so its arc spans the screen.
const horizon =
  'absolute top-[calc(100%-80px)] left-1/2 h-[800px] w-[200%] -translate-x-1/2 md:top-[calc(100%-120px)] md:h-[1200px]';
---

<section
  class="relative -mt-[65px] flex min-h-svh flex-col overflow-hidden bg-field text-on-field"
  aria-label="Introduction"
>
  <Starfield />
  {/*
    Planet Malone's horizon: the page itself rising into the hero as a wide
    curve, under a thin, breathing Persimmon atmosphere. Both are the same
    ellipse, peaking a little above the hero's bottom edge.
  */}
  <div
    class:list={[horizon, 'horizon-glow animate-glow motion-reduce:animate-none']}
    aria-hidden="true"
  ></div>
  <div class:list={[horizon, 'horizon planet-dawn']} aria-hidden="true"></div>
  {/*
    Marks where the horizon meets the screen's edges (./pmHorizon.ts): once
    that passes under the header, the whole curve has cleared it. The ellipse is
    always twice the screen's width, so its sides sit a fixed height below the
    peak: 13.4% of its half-height (54px on phones, 80px on desktop).
  */}
  <pm-horizon class="absolute inset-x-0 bottom-[26px] h-px md:bottom-[39px]" aria-hidden="true"></pm-horizon>

  <div class="relative mx-auto my-auto grid w-full max-w-page gap-5 px-gutter pt-12 pb-[18svh] scroll-fade">
    {/* A mission-control status readout */}
    <div class="grid gap-1 font-mono text-sm">
      <p class="flex items-baseline gap-2.5">
        <span
          class="size-2 flex-none animate-pulse bg-metric motion-reduce:animate-none"
          aria-hidden="true"
        ></span>
        <span>
          <span class="text-on-field/65">Status:</span> {profile.status}
        </span>
      </p>
      <p class="pl-4.5 text-on-field/65">
        {profile.location}
        <Clock timeZone={profile.timezone} label=" · Local time on Planet Malone:" />
      </p>
    </div>
    <h1 class="text-hero-sm font-extrabold md:text-hero-md lg:text-hero">{profile.name}</h1>
    <p class="max-w-170 text-lg/[1.4] md:text-2xl/[1.4]">{profile.lead}</p>
  </div>
</section>
{/*
  More planet surface below the fold, so light mode's dawn finishes before the
  hero's edge shows. Dark mode keeps it too, for the same spacing.
*/}
<div class="h-[25svh] bg-bg planet-dawn print:hidden" aria-hidden="true"></div>

<script>
  import './pmHorizon';
</script>
