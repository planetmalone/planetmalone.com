---
/**
 * Contact: the dark "Say hello" card, with illustrated Sean waving from its
 * bottom edge.
 */
import { Picture } from 'astro:assets';
import { Button } from '../Button';
import { CopyEmail } from '../CopyEmail';
import { SectionHeading } from '../SectionHeading';
import { getSingleton } from '../../utils/content';
import wave from '../../assets/illos/illo-wave.png';

const profile = await getSingleton('profile');
---

<section
  class="relative grid scroll-mt-[90px] gap-5.5 rounded-field bg-dark-card px-5.5 pt-7 text-dark-card-ink md:p-11 md:pr-72"
  id="contact"
  aria-labelledby="contact-heading"
>
  <SectionHeading id="contact-heading" size="xl">
    Say hello<span class="text-c-accent">.</span>
  </SectionHeading>
  <p class="max-w-140 text-lg/normal text-dark-card-2">{profile.contact.availability}</p>
  <div class="flex flex-wrap items-center gap-3">
    <a
      class="text-email font-bold break-all text-dark-card-ink no-underline hover:text-c-accent"
      href={`mailto:${profile.email}`}
    >
      {profile.email}
    </a>
    <CopyEmail />
  </div>
  <div class="flex flex-wrap gap-2.5 text-ui">
    <Button variant="dark-outline" href={profile.links.linkedin}>
      LinkedIn <span aria-hidden="true">↗</span>
    </Button>
    <Button variant="dark-outline" href={profile.links.github}>
      GitHub <span aria-hidden="true">↗</span>
    </Button>
    {profile.resumes.map((r) => (
      <Button variant="dark-outline" href={r.href}>
        {r.label} (PDF, {r.updated})
      </Button>
    ))}
  </div>
  <Picture
    src={wave}
    formats={['avif', 'webp']}
    widths={[320, 560]}
    sizes="(max-width: 899px) 160px, 260px"
    alt="Illustrated Sean waving"
    class="block h-auto w-full"
    pictureAttributes={{
      class: 'block w-40 justify-self-end md:absolute md:right-8 md:bottom-0 md:w-65',
    }}
  />
</section>
