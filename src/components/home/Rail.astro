---
/**
 * The sticky left rail on desktop: section nav, then the résumé and email
 * buttons. Phase 4 moves `aria-current` as the visitor scrolls; the server
 * marks the first section current, as it is at the top of the page.
 */
import { Button } from '../Button';
import { sections } from '../../data/site';
import { getSingleton } from '../../utils/content';

const profile = await getSingleton('profile');
---

<aside class="sticky top-24 grid gap-7 self-start max-md:hidden print:hidden">
  <nav class="grid gap-1 text-sm font-semibold tracking-[0.02em]" aria-label="Sections">
    {sections.map((s, i) => (
      <a
        class="group flex items-center gap-3 py-1.5 text-ink2 no-underline hover:text-ink aria-[current=true]:text-ink"
        href={`#${s.id}`}
        aria-current={i === 0 ? 'true' : undefined}
        data-rail-link={s.id}
      >
        <span
          class="h-0.5 w-4.5 bg-line transition-[width] duration-200 ease-standard group-aria-[current=true]:w-10 group-aria-[current=true]:bg-accent"
          aria-hidden="true"
        />
        {s.label}
      </a>
    ))}
  </nav>
  <div class="grid gap-2">
    {profile.resumes.map((r) => (
      <Button variant="solid" size="sm" href={r.href}>
        {r.label}
      </Button>
    ))}
    <Button variant="outline" size="sm" href={`mailto:${profile.email}`} data-copy-email>
      Copy email
    </Button>
  </div>
</aside>
