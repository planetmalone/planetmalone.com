---
/**
 * Experience: the journey so far, oldest first, down a wavy flight path. Each
 * role is a planet on the path (the degree, a satellite), with its start year
 * on one side and the role on the other, swapping sides down the page on
 * desktop (on phones the path runs down the left). As you scroll,
 * <pm-experience> (./pmExperience.ts) draws the path through the planets and
 * flies the rocket to the planet you've reached, turning around when you scroll
 * back up. The path and rocket are decoration, hidden from screen readers;
 * without JS the roles still read top to bottom.
 */
import { Image } from 'astro:assets';
import { Chip } from '../Chip';
import { Planet } from '../Planet';
import { SectionHeading } from '../SectionHeading';
import { getRoles, getSingleton } from '../../utils/content';
import { formatYears } from '../../utils/format';

const [roles, profile] = await Promise.all([getRoles(), getSingleton('profile')]);
const { education } = profile;

type Stop = {
  id: string;
  start: number;
  dates: string;
  title: string;
  company?: string | undefined;
  /** The one-line description: a role's scope, or the degree's honors. */
  note?: string | undefined;
  tech: string[];
  caseStudy?: string | undefined;
  satellite?: boolean;
};

// Oldest first, with the degree slotted in by year as a satellite.
const stops: Stop[] = [...roles].reverse().map(({ id, data }) => ({
  id,
  start: data.years.start,
  dates: formatYears(data.years),
  title: data.title,
  company: data.company,
  tech: data.tech,
  note: data.scope,
  caseStudy: data.caseStudy?.id,
}));
const school: Stop = {
  id: 'ut-dallas',
  start: education.year,
  dates: String(education.year),
  title: education.degree,
  company: education.school,
  note: education.honors,
  tech: [],
  satellite: true,
};
const at = stops.findIndex((s) => s.start >= education.year);
stops.splice(at < 0 ? stops.length : at, 0, school);

// Company logos, by stop id: src/assets/logos/<id>.svg (or .png, .webp, .jpg).
const logoFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/logos/*.{svg,png,webp,jpg}', {
  eager: true,
});
const logos = Object.fromEntries(
  Object.entries(logoFiles).map(([path, mod]) => [
    path
      .split('/')
      .pop()!
      .replace(/\.\w+$/, ''),
    mod.default,
  ]),
);
---

<section class="grid scroll-mt-[90px] gap-6" id="experience" aria-labelledby="experience-heading">
  <SectionHeading id="experience-heading">Experience</SectionHeading>

  <pm-experience class="relative block">
    <svg class="pointer-events-none absolute inset-0 size-full overflow-visible" aria-hidden="true">
      <path
        class="fill-none stroke-ink2/45 [stroke-dasharray:2_9]"
        stroke-width="2.5"
        stroke-linecap="round"
        data-path
      ></path>
    </svg>

    <ol class="relative grid">
      {stops.map((stop, i) => {
        // Even stops put the role on the right of the path, odd ones on the left (desktop).
        const right = i % 2 === 0;
        const logo = logos[stop.id];
        return (
          <li
            class="group grid grid-cols-[80px_minmax(0,1fr)] items-center gap-x-4 py-20 md:grid-cols-[minmax(0,1fr)_300px_minmax(0,1fr)] md:gap-x-6 md:py-32"
            data-stop={stop.id}
          >
            <span
              class:list={[
                'grid place-items-center transition-[scale] duration-300 ease-standard group-data-current:scale-125 md:col-start-2 md:row-start-1',
                right ? '-translate-x-4.5 md:-translate-x-27' : 'translate-x-4.5 md:translate-x-27',
              ]}
              data-planet
            >
              <Planet look={stop.satellite ? 'satellite' : i} size={52} />
            </span>
            <p
              class:list={[
                'font-display text-hero-sm font-bold text-ink2/45 max-md:hidden md:row-start-1',
                right ? 'md:col-start-1 md:text-right' : 'md:col-start-3',
              ]}
              aria-hidden="true"
            >
              {stop.start}
            </p>
            <div
              class:list={[
                'grid gap-2 md:row-start-1',
                right ? 'md:col-start-3' : 'md:col-start-1 md:justify-items-end md:text-right',
              ]}
            >
              <p class="font-mono text-sm text-ink2">{stop.dates}</p>
              <h3 class="text-card-title font-bold text-pretty">{stop.title}</h3>
              {(stop.company || logo) && (
                <p
                  class:list={[
                    'flex items-center gap-2.5 text-lg text-ink2',
                    { 'md:flex-row-reverse': !right },
                  ]}
                >
                  {logo && <Image src={logo} alt="" height={28} class="h-7 w-auto" />}
                  {stop.company}
                </p>
              )}
              {stop.note && <p class="max-w-110 text-ui/normal text-ink3">{stop.note}</p>}
              {stop.tech.length > 0 && (
                <ul class:list={['flex flex-wrap gap-1.5', { 'md:justify-end': !right }]} aria-label="Tech">
                  {stop.tech.map((t) => (
                    <Chip as="li" kind="tech">
                      {t}
                    </Chip>
                  ))}
                </ul>
              )}
              {stop.caseStudy && (
                <a class="text-ui font-bold" href={`/work/${stop.caseStudy}`}>
                  Read the case study →
                </a>
              )}
            </div>
          </li>
        );
      })}
    </ol>

    {/* The rocket, pointing right; <pm-experience> places and turns it. */}
    <span class="pointer-events-none absolute top-0 left-0 z-1 print:hidden" aria-hidden="true" data-rocket>
      <svg viewBox="0 0 40 22" width="40" height="22" class="block overflow-visible">
        <path class="origin-[8px_11px] animate-flicker fill-accent" d="M8 7 L-2 11 L8 15 Z"></path>
        <path
          class="origin-[8px_11px] animate-flicker fill-c-accent [animation-delay:-0.15s]"
          d="M8 9 L2 11 L8 13 Z"
        ></path>
        <path
          class="fill-surface stroke-ink"
          stroke-width="1.6"
          stroke-linejoin="round"
          d="M8 5 H25 C32 5 37 8 39 11 C37 14 32 17 25 17 H8 Z"
        ></path>
        <path
          class="fill-accent stroke-ink"
          stroke-width="1.6"
          stroke-linejoin="round"
          d="M11 5 L7 0 L17 5 Z M11 17 L7 22 L17 17 Z"
        ></path>
        <circle class="fill-green stroke-ink" stroke-width="1.6" cx="27" cy="11" r="3"></circle>
      </svg>
    </span>
  </pm-experience>
</section>

<script>
  import './pmExperience';
</script>
