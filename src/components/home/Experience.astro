---
/**
 * Experience: the scenic route (FlightPath), the role cards and education.
 *
 * Role cards are <details> sharing a `name`, so the browser keeps one open at a
 * time with no JS; the first is open on load. <pm-experience>
 * (./pmExperience.ts) publishes the open role, and the flight path shows it.
 */
import { Chip } from '../Chip';
import { FlightPath } from '../FlightPath';
import { SectionHeading } from '../SectionHeading';
import { getRoles, getSingleton } from '../../utils/content';
import { formatYears } from '../../utils/format';

const [experience, roles, profile] = await Promise.all([
  getSingleton('experience'),
  getRoles(),
  getSingleton('profile'),
]);
const currentRole = roles[0]?.id;
// The flight path runs oldest to newest.
const route = roles
  .map((r) => ({ id: r.id, stage: r.data.stage, name: r.data.company ?? r.data.title }))
  .reverse();
const { education, volunteer } = profile;
---

<section class="grid scroll-mt-[90px] gap-6" id="experience" aria-labelledby="experience-heading">
  <pm-experience class="contents" default-role={currentRole}>
    <SectionHeading id="experience-heading">Experience</SectionHeading>

    {/* Sticks under the 65px header while the role cards scroll beneath it */}
    <div class="sticky top-[65px] z-10 -my-3 bg-bg py-3">
      <FlightPath
        label={experience.routeLabel}
        stages={experience.stages}
        roles={route}
        current={currentRole}
      />
    </div>

    <ol class="grid gap-2.5">
      {roles.map(({ id, data: role }, i) => {
        const dates = formatYears(role.years);
        return (
          <li>
            <details
              class:list={[
                'group rounded-tile border bg-surface transition-colors duration-150 open:border-ink hover:border-accent',
                // Animate the height as the card opens and closes
                'details-content:h-0 details-content:overflow-clip open:details-content:h-auto',
                'details-content:transition-[height,content-visibility] details-content:transition-discrete details-content:duration-200 details-content:ease-standard',
              ]}
              name="role"
              open={i === 0}
              data-stage={role.stage}
              data-role={id}
            >
              <summary
                class:list={[
                  'grid cursor-pointer list-none items-start gap-4.5 rounded-tile px-5 py-4.5 [&::-webkit-details-marker]:hidden',
                  'grid-cols-[minmax(0,1fr)_28px] md:grid-cols-[104px_minmax(0,1fr)_28px]',
                ]}
              >
                <span class="pt-0.75 text-sm text-ink2 tabular-nums max-md:hidden">{dates}</span>
                <span class="grid gap-1">
                  <span class="text-caption text-ink2 tabular-nums md:hidden">{dates}</span>
                  <span class="text-lg font-bold">
                    {role.title}
                    {role.company && <span class="font-normal text-ink2"> · {role.company}</span>}
                  </span>
                  <span class="text-ui/[1.45] text-ink2">{role.scope}</span>
                </span>
                <span
                  class:list={[
                    'grid size-7 place-items-center rounded-full border font-bold text-accent',
                    'group-open:border-btn group-open:bg-btn group-open:text-btn-ink',
                  ]}
                  aria-hidden="true"
                >
                  <span class="group-open:hidden">+</span>
                  <span class="hidden group-open:inline">−</span>
                </span>
              </summary>

              <div class="grid gap-3.5 px-5 pb-5 md:pl-35.5">
                <ul class="grid list-[circle] gap-1.5 pl-4.5 leading-normal">
                  {role.wins.map((w) => (
                    <li>{w}</li>
                  ))}
                </ul>
                {role.tech.length > 0 && (
                  <ul class="flex flex-wrap gap-1.5" aria-label="Tech">
                    {role.tech.map((t) => (
                      <Chip as="li" kind="tech">
                        {t}
                      </Chip>
                    ))}
                  </ul>
                )}
                {role.aside && <p class="text-sm text-accent italic">{role.aside}</p>}
                {role.caseStudy && (
                  <a class="text-ui font-bold" href={`/work/${role.caseStudy.id}`}>
                    Read the case study →
                  </a>
                )}
              </div>
            </details>
          </li>
        );
      })}
    </ol>

    <div class="grid gap-4.5 text-ui/normal md:grid-cols-2">
      <p>
        <b>{education.degree}</b>, {education.school}, {education.year}
        <span class="block text-ink2">{education.honors}</span>
      </p>
      <p>
        <b>{volunteer.org}</b>, {volunteer.since} - present
        <span class="block text-ink2">{volunteer.note}</span>
      </p>
    </div>
  </pm-experience>
</section>

<script>
  import './pmExperience';
</script>
