---
/**
 * A dark card with a big green number: case-study outcomes (md) and the
 * Colophon's budgets (sm).
 */
interface Props {
  value: string;
  label: string;
  size?: 'sm' | 'md';
}

const { value, label, size = 'md' }: Props = Astro.props;
// Big Shoulders has no "→" glyph, so the fallback font's arrow renders small and low.
const parts = value.split(/\s*→\s*/);
---

<div
  class:list={[
    'grid content-start gap-1.5 rounded-outcome bg-dark-card text-dark-card-ink tabular-nums',
    size === 'md' ? 'p-5.5' : 'p-5',
  ]}
>
  <p class:list={['font-display font-extrabold text-metric', size === 'md' ? 'text-outcome' : 'text-budget']}>
    {parts.map((part, i) => (
      <>
        {i > 0 && (
          <>
            <svg
              class="mx-[0.12em] inline-block h-[0.42em] w-[0.56em] align-[0.14em]"
              viewBox="0 0 24 18"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              aria-hidden="true"
            >
              <path d="M1 9h19M13 2l7 7-7 7" />
            </svg>
            <span class="sr-only">to</span>
          </>
        )}
        <span class="whitespace-nowrap">{part}</span>
      </>
    ))}
  </p>
  <p class:list={['text-dark-card-2', size === 'md' ? 'text-ui' : 'text-sm']}>{label}</p>
</div>
