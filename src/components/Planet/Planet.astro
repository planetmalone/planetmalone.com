---
/**
 * A small hand-drawn planet in the logo's sketchy style (the shared `#rough`
 * filter in BaseLayout.astro). `look` picks one of five, cycling, so a row of
 * planets varies, or 'satellite' for a little satellite instead. Decoration only.
 */
interface Props {
  look: number | 'satellite';
  size: number;
  class?: string;
}

const LOOKS = [
  { fill: 'fill-green', ring: true },
  { fill: 'fill-sunken', craters: true },
  { fill: 'fill-accent', band: true },
  { fill: 'fill-ink2', ring: true },
  { fill: 'fill-metric', band: true },
];

const { look, size, class: className } = Astro.props;
const l = look === 'satellite' ? undefined : LOOKS[look % LOOKS.length]!;
---

<svg
  viewBox="0 0 32 32"
  width={size}
  height={size}
  class:list={['block overflow-visible', className]}
  filter="url(#rough)"
  aria-hidden="true"
  focusable="false"
>
  {l ? (
    <>
      <circle cx="16" cy="16" r="10" class:list={[l.fill, 'stroke-ink']} stroke-width="1.6"></circle>
      {l.band && (
        <path
          d="M8 14 C13 12 18 16 24 14 M9 20 C14 18 19 21 23 19"
          class="fill-none stroke-ink opacity-40"
          stroke-width="1.3"
          stroke-linecap="round"
        />
      )}
      {l.craters && (
        <g class="fill-none stroke-ink opacity-50" stroke-width="1.2">
          <circle cx="12" cy="13" r="2" />
          <circle cx="19" cy="19" r="2.6" />
        </g>
      )}
      {l.ring && (
        <path
          d="M2 21 C0 17 12 11 21 10 C29 9 33 11 30 14 M30 14 C28 18 20 21 13 22 C6 23 3 23 2 21"
          class="fill-none stroke-ink"
          stroke-width="1.4"
          stroke-linecap="round"
        />
      )}
    </>
  ) : (
    // A satellite: a body with a dish and antenna, between two solar panels.
    <g transform="rotate(-25 16 16)" stroke-linejoin="round">
      <path d="M10.5 16 H12 M20 16 H21.5" class="stroke-ink" stroke-width="1.4" />
      <rect x="1" y="12.5" width="9.5" height="7" class="fill-green stroke-ink" stroke-width="1.4" />
      <rect x="21.5" y="12.5" width="9.5" height="7" class="fill-green stroke-ink" stroke-width="1.4" />
      <path
        d="M4.2 12.5 V19.5 M7.4 12.5 V19.5 M24.7 12.5 V19.5 M27.9 12.5 V19.5"
        class="stroke-ink opacity-50"
        stroke-width="1"
      />
      <rect x="12" y="12" width="8" height="8" rx="1" class="fill-sunken stroke-ink" stroke-width="1.4" />
      <path
        d="M13 12 C13.5 9 18.5 9 19 12 M16 10 V6"
        class="fill-none stroke-ink"
        stroke-width="1.3"
        stroke-linecap="round"
      />
      <circle cx="16" cy="5.5" r="1.3" class="fill-accent stroke-ink" stroke-width="1" />
    </g>
  )}
</svg>
