---
/**
 * The scenic route: each career stage is a planet, and each role a moon around
 * it. On desktop it's a window onto a wider map. The first time it's seen, a
 * rocket flies the journey past every planet to the open role's moon; after
 * that it flies to whichever role card is opened, with the camera following.
 * On phones it's a row of stage pills that the rocket hops between.
 * <pm-flight-path> (./pmFlightPath.ts) does the flying and the camera.
 *
 * Decoration only: it's hidden from screen readers, which go straight to the
 * role cards. Without JS the rocket is parked at the open role.
 * The map is laid out in pixels; the camera centers a map x in the window.
 */
interface Props {
  label: string;
  stages: { id: string; label: string }[];
  /** Oldest first. */
  roles: { id: string; stage: string; name: string }[];
  current: string | undefined;
}

const { label, stages, roles, current }: Props = Astro.props;

// Map layout, in px. The window is 150px tall; planets sit along it with a wobble.
const START = 170;
const GAP = 540;
const WOBBLE = [78, 68, 80, 66, 76];
const ORBIT = { rx: 118, ry: 40 };
// Moon angles around the planet by moon count (degrees; 0 is right, 90 is down),
// chosen so moon names clear the period name under the planet.
const ANGLES: Record<number, number[]> = { 1: [-30], 2: [200, -30], 3: [200, -55, 15] };
// The rocket parks beside its moon, on the outer side, nudged away from the moon's name
// (down for upper moons, whose names sit above; up for lower ones).
const PARK = { distance: 38, lift: 8 };
const LOOKS = [
  { size: 44, fill: 'fill-green', ring: true },
  { size: 36, fill: 'fill-sunken', craters: true },
  { size: 48, fill: 'fill-accent', band: true },
  { size: 42, fill: 'fill-ink2', ring: true },
  { size: 46, fill: 'fill-metric', band: true },
];

const rad = (deg: number) => (deg * Math.PI) / 180;
const planets = stages.map((s, i) => {
  const x = START + i * GAP;
  const y = WOBBLE[i] ?? 75;
  const own = roles.filter((r) => r.stage === s.id);
  const angles = ANGLES[own.length] ?? own.map((_, j) => -90 + (360 / own.length) * j);
  const moons = own.map((r, j) => {
    const a = rad(angles[j]!);
    const mx = x + ORBIT.rx * Math.cos(a);
    const my = y + ORBIT.ry * Math.sin(a);
    const side = Math.cos(a) >= 0 ? 1 : -1;
    const px = mx + side * PARK.distance;
    const py = my + (my < y ? PARK.lift : -PARK.lift);
    // Parked nose-in, facing its moon.
    const pa = (Math.atan2(my - py, mx - px) * 180) / Math.PI;
    return { ...r, x: mx, y: my, px, py, pa, above: my < y };
  });
  return { ...s, x, y, look: LOOKS[i]!, moons };
});
const moons = planets.flatMap((p) => p.moons);
const active = moons.find((m) => m.id === current) ?? moons.at(-1)!;
const width = START + (stages.length - 1) * GAP + 260;
// Center the camera between the active moon and its parked rocket.
const camera = (active.x + active.px) / 2;
const round = (n: number) => Math.round(n * 10) / 10;
---

<pm-flight-path class="block" aria-hidden="true" data-start="40,75">
  {/* Desktop: a window onto the map */}
  <div class="relative h-37.5 overflow-hidden rounded-tile bg-color max-md:hidden print:hidden" data-window>
    <div
      class="absolute top-0 left-1/2 h-full"
      style={`width: ${width}px; transform: translateX(${-round(camera)}px)`}
      data-world
    >
      <svg class="absolute inset-0 overflow-visible" width={width} height="150">
        <defs>
          {/* The logo's hand-drawn wobble */}
          <filter id="flight-rough" x="-10%" y="-10%" width="120%" height="120%">
            <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7"></feTurbulence>
            <feDisplacementMap in="SourceGraphic" scale="2.6"></feDisplacementMap>
          </filter>
        </defs>
        {planets.map((p) => (
          <ellipse
            cx={p.x}
            cy={p.y}
            rx={ORBIT.rx}
            ry={ORBIT.ry}
            class="fill-none stroke-line [stroke-dasharray:4_6]"
            stroke-width="1.5"
          />
        ))}
      </svg>

      {planets.map((p) => (
        <span class="absolute -translate-1/2" style={`left: ${p.x}px; top: ${p.y}px`} data-planet={p.id}>
          <svg
            viewBox="0 0 32 32"
            width={p.look.size}
            height={p.look.size}
            class="block overflow-visible"
            filter="url(#flight-rough)"
          >
            <circle cx="16" cy="16" r="10" class:list={[p.look.fill, 'stroke-ink']} stroke-width="1.6" />
            {p.look.band && (
              <path
                d="M8 14 C13 12 18 16 24 14 M9 20 C14 18 19 21 23 19"
                class="fill-none stroke-ink opacity-40"
                stroke-width="1.3"
                stroke-linecap="round"
              />
            )}
            {p.look.craters && (
              <g class="fill-none stroke-ink opacity-50" stroke-width="1.2">
                <circle cx="12" cy="13" r="2" />
                <circle cx="19" cy="19" r="2.6" />
              </g>
            )}
            {p.look.ring && (
              <path
                d="M2 21 C0 17 12 11 21 10 C29 9 33 11 30 14 M30 14 C28 18 20 21 13 22 C6 23 3 23 2 21"
                class="fill-none stroke-ink"
                stroke-width="1.4"
                stroke-linecap="round"
              />
            )}
          </svg>
          <span class="absolute top-full left-1/2 mt-1 -translate-x-1/2 font-mono text-xs font-bold whitespace-nowrap text-ink3">
            {p.label}
          </span>
        </span>
      ))}

      {moons.map((m) => (
        <span
          class="group absolute"
          style={`left: ${round(m.x)}px; top: ${round(m.y)}px`}
          data-moon={m.id}
          data-stage={m.stage}
          data-park={`${round(m.px)},${round(m.py)},${round(m.pa)}`}
          data-current={m.id === current ? '' : undefined}
        >
          <span class="absolute size-4 -translate-1/2 rounded-full border bg-sunken transition-colors duration-200 group-data-current:border-ink group-data-current:bg-green-dot" />
          <span
            class:list={[
              'absolute -translate-x-1/2 rounded-pill px-1.5 text-xs font-semibold whitespace-nowrap text-ink2 transition-colors duration-200',
              'group-data-current:bg-btn group-data-current:text-btn-ink',
              m.above ? 'bottom-2.5' : 'top-2.5',
            ]}
          >
            {m.name}
          </span>
        </span>
      ))}

      {/* The rocket, pointing right; parked nose-in beside the active moon. */}
      <span
        class="absolute z-1"
        style={`left: ${round(active.px)}px; top: ${round(active.py)}px; transform: translate(-50%, -50%) rotate(${round(active.pa)}deg)`}
        data-rocket
      >
        <svg viewBox="0 0 40 22" width="40" height="22" class="block overflow-visible">
          <path class="origin-[8px_11px] animate-flicker fill-accent" d="M8 7 L-2 11 L8 15 Z" />
          <path
            class="origin-[8px_11px] animate-flicker fill-c-accent [animation-delay:-0.15s]"
            d="M8 9 L2 11 L8 13 Z"
          />
          <path
            class="fill-surface stroke-ink"
            stroke-width="1.6"
            stroke-linejoin="round"
            d="M8 5 H25 C32 5 37 8 39 11 C37 14 32 17 25 17 H8 Z"
          />
          <path
            class="fill-accent stroke-ink"
            stroke-width="1.6"
            stroke-linejoin="round"
            d="M11 5 L7 0 L17 5 Z M11 17 L7 22 L17 17 Z"
          />
          <circle class="fill-green stroke-ink" stroke-width="1.6" cx="27" cy="11" r="3" />
        </svg>
      </span>
    </div>
  </div>

  {/* Phones: stage pills the rocket hops between */}
  <div class="relative md:hidden print:hidden" data-pills>
    <p class="mb-2 text-caption text-ink2">{label}</p>
    <ol class="flex flex-wrap items-center gap-x-2 gap-y-3 text-sm font-semibold">
      {stages.map((s, i) => (
        <li class="flex items-center gap-2">
          <span
            class="rounded-pill border px-3 py-1.25 text-ink3 transition-colors duration-200 data-current:border-btn data-current:bg-btn data-current:text-btn-ink"
            data-pill={s.id}
            data-current={s.id === active.stage ? '' : undefined}
          >
            {s.label}
          </span>
          {i < stages.length - 1 && <span class="text-accent">→</span>}
        </li>
      ))}
    </ol>
    {/* Placed on the active stage's pill by <pm-flight-path> */}
    <span class="absolute top-0 left-0 z-1 w-6" data-mobile-rocket>
      <svg viewBox="0 0 40 22" width="24" height="13" class="block overflow-visible">
        <path class="origin-[8px_11px] animate-flicker fill-accent" d="M8 7 L-2 11 L8 15 Z" />
        <path
          class="fill-surface stroke-ink"
          stroke-width="2"
          stroke-linejoin="round"
          d="M8 5 H25 C32 5 37 8 39 11 C37 14 32 17 25 17 H8 Z"
        />
        <path
          class="fill-accent stroke-ink"
          stroke-width="2"
          stroke-linejoin="round"
          d="M11 5 L7 0 L17 5 Z M11 17 L7 22 L17 17 Z"
        />
        <circle class="fill-green stroke-ink" stroke-width="2" cx="27" cy="11" r="3" />
      </svg>
    </span>
  </div>
</pm-flight-path>

<script>
  import './pmFlightPath';
</script>
