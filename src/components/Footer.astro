---
import { SegmentedControl } from './SegmentedControl';
import { Switch } from './Switch';
import { site } from '../data/site';

const themes = [
  { value: 'light', label: 'Light' },
  { value: 'dark', label: 'Dark' },
  { value: 'system', label: 'System' },
];
---

<footer class="mx-auto grid max-w-page gap-5.5 px-gutter pt-18 pb-12 text-sm text-ink2 print:hidden">
  <p class="font-display text-footer-title font-bold text-ink">Thanks for visiting Planet Malone.</p>
  <ul class="flex flex-wrap gap-x-3.5 gap-y-2.5" aria-label="This site will not">
    <li aria-hidden="true">This site will not:</li>
    <li>
      <span aria-hidden="true">×</span> track you
    </li>
    <li>
      <span aria-hidden="true">×</span> drain your battery
    </li>
    <li>
      <span aria-hidden="true">×</span> make a sound
    </li>
    <li>
      <span aria-hidden="true">×</span> ask about cookies
    </li>
  </ul>

  <div class="needs-js flex flex-wrap items-center gap-5 border-y py-4">
    <SegmentedControl name="theme" legend="Theme" options={themes} data-theme-options />

    <Switch label="Motion" id="motion-switch" />
  </div>

  <div class="flex flex-wrap justify-between gap-3">
    <span>
      v. {site.version} · Last updated {site.lastUpdated}, by a human, with coffee
    </span>
    <span class="flex flex-wrap gap-3.5">
      <a href="/now">Now</a>
      <a href="/uses">Uses</a>
      <a href="/colophon">Built with Astro</a>
    </span>
  </div>
</footer>

<script>
  import { themePref, type ThemePref } from '../stores/theme';
  import { motion } from '../stores/motion';

  const radios = document.querySelectorAll<HTMLInputElement>('[data-theme-options] input');
  themePref.subscribe((pref) => radios.forEach((r) => (r.checked = r.value === pref)));
  radios.forEach((r) => r.addEventListener('change', () => themePref.set(r.value as ThemePref)));

  const motionSwitch = document.getElementById('motion-switch')!;
  motion.subscribe((on) => motionSwitch.toggleAttribute('checked', on));
  motionSwitch.addEventListener('change', () => motion.set(motionSwitch.hasAttribute('checked')));
</script>
