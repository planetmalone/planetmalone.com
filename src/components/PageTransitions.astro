---
// Cross-page view transitions (see @view-transition in base.css). Inline in
// <head> on purpose: `pagereveal` must be handled before the first paint.
//
// Case titles (`data-vt-case`) are named only for the navigation that needs
// them, so exactly one title morphs:
// - to a case study: that case's title on the page you're leaving (home card
//   or Previous / Next card) morphs into its H1;
// - from a case study to home: its H1 morphs into its home card.
// With Motion off, the transition is skipped. Leaving a page also stops the
// starfield's drift (data-leaving, base.css): while it runs, Chrome can drop the
// transition. Coming back from the back/forward cache clears it.
---

<script is:inline>
  (() => {
    const root = document.documentElement;
    const caseOf = (url) => (url ? new URL(url).pathname.match(/^\/work\/([\w-]+)$/)?.[1] : undefined);
    const isHome = (url) => !!url && new URL(url).pathname === '/';

    const name = (slug, vt) => {
      const el = slug && document.querySelector(`[data-vt-case="${slug}"]`);
      if (!el) return;
      el.style.viewTransitionName = 'case-title';
      vt.finished.finally(() => (el.style.viewTransitionName = ''));
    };

    addEventListener('pageswap', (e) => {
      if (!e.viewTransition) return;
      if (root.dataset.motion === 'off') return e.viewTransition.skipTransition();
      root.dataset.leaving = '';
      const to = e.activation?.entry?.url;
      name(caseOf(to) ?? (isHome(to) ? caseOf(location.href) : undefined), e.viewTransition);
    });

    addEventListener('pageshow', () => delete root.dataset.leaving);

    addEventListener('pagereveal', (e) => {
      // Land on a section link (like a case study's "Back to Planet Malone", to
      // #impact) instantly, before the first paint: the transition then starts
      // with that section on screen, so a case title zooms into its card rather
      // than the page gliding down afterward.
      if (location.hash)
        document.getElementById(location.hash.slice(1))?.scrollIntoView({ behavior: 'instant' });
      if (!e.viewTransition) return;
      if (root.dataset.motion === 'off') return e.viewTransition.skipTransition();
      const from = navigation?.activation?.from?.url;
      const here = caseOf(location.href);
      if (here) name(here, e.viewTransition);
      else if (isHome(location.href)) name(caseOf(from), e.viewTransition);
    });
  })();
</script>
