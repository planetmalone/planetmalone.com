---
/**
 * A live clock for one time zone, upgraded by the <pm-clock> custom element
 * (./pmClock.ts). The time only exists client-side, so the whole clock is
 * hidden without JS rather than showing a time frozen at build. The <time> is
 * pre-sized to the widest "h:mm AM" ("10:00 AM", about 7.2ch) and holds a
 * non-breaking space until then (an empty inline-block has no text baseline),
 * so filling it in never shifts the layout.
 *
 *   <Clock timeZone="America/Chicago" label="Local time on Planet Malone:" />
 */
interface Props {
  timeZone: string;
  label: string;
  class?: string;
}

const { timeZone, label, class: className } = Astro.props;
---

<pm-clock class:list={['needs-js', className]} time-zone={timeZone}>
  {label} <time class="inline-block min-w-[7.5ch] text-right tabular-nums">&nbsp;</time>
</pm-clock>

<script>
  import './pmClock';
</script>
