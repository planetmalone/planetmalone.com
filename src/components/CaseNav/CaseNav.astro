---
/**
 * Previous / next case-study cards at the bottom of a case study, looping
 * through the four. The chosen title morphs into the next page's H1 (see
 * PageTransitions.astro).
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  prev: CollectionEntry<'cases'>;
  next: CollectionEntry<'cases'>;
}

const { prev, next }: Props = Astro.props;
const links = [
  { entry: prev, label: '← Previous', align: '' },
  { entry: next, label: 'Next →', align: 'text-right' },
];
---

<nav class="grid gap-3.5 border-t pt-7 text-base md:grid-cols-2 print:hidden" aria-label="More case studies">
  {links.map(({ entry, label, align }) => (
    <a
      class:list={[
        'rounded-tile border p-4 text-ink no-underline transition-colors duration-150 hover:border-accent hover:text-ink',
        align,
      ]}
      href={`/work/${entry.id}`}
    >
      <span class="block text-sm text-ink2">{label}</span>
      <b class="block" data-vt-case={entry.id}>
        {entry.data.title}
      </b>
    </a>
  ))}
</nav>
