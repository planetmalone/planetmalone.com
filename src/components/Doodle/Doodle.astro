---
/**
 * Hand-drawn doodles in the logo's sketchy style. Strokes wobble through the
 * shared `#rough` filter (BaseLayout.astro), except the small arrow, where the
 * wobble would turn to mush. Decoration only, so hidden from screen readers.
 *
 * - frame: a sketched border that fills its positioned parent.
 * - arrow: a small hand-drawn arrow, sized to the text.
 */
interface Props {
  name: 'frame' | 'arrow';
  class?: string;
}

const { name, class: className } = Astro.props;
---

{name === 'frame' && (
  <svg
    class:list={['absolute inset-0 size-full overflow-visible', className]}
    aria-hidden="true"
    focusable="false"
  >
    <g class="fill-none stroke-current" filter="url(#rough)">
      <rect x="2" y="2" rx="20" class="[height:calc(100%-4px)] [width:calc(100%-4px)]" stroke-width="2" />
      <rect
        x="5"
        y="0"
        rx="24"
        class="[height:calc(100%-3px)] [width:calc(100%-9px)] opacity-35"
        stroke-width="1.5"
      />
    </g>
  </svg>
)}

{name === 'arrow' && (
  <svg class={className} viewBox="0 0 26 14" aria-hidden="true" focusable="false">
    <path
      class="fill-none stroke-current"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M2 8 C8 6.5 14 8.5 22.5 6.5 M16.5 2.5 C19 4 21 5.5 23 6.5 C21 8 19 9.5 17 11.5"
    />
  </svg>
)}
