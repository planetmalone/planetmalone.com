---
/**
 * A photo that fills its (positioned) frame and opens larger in a modal on click.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string | undefined;
  /** The image shown in the frame, when it differs from the one the modal opens. */
  thumb?: ImageMetadata | undefined;
  widths: number[];
  sizes: string;
}

const { src, alt, caption, thumb, widths, sizes }: Props = Astro.props;
const formats: ('avif' | 'webp')[] = ['avif', 'webp'];
---

<pm-lightbox class="contents">
  <button
    type="button"
    class="group absolute inset-0 cursor-zoom-in overflow-hidden focus-visible:-outline-offset-3"
    aria-haspopup="dialog"
    aria-label={`View larger: ${alt}`}
    data-open
  >
    <Picture
      src={thumb ?? src}
      alt=""
      formats={formats}
      widths={widths}
      sizes={sizes}
      class="absolute inset-0 size-full object-cover transition-transform duration-300 group-hover:scale-103"
      pictureAttributes={{ class: 'contents' }}
    />
  </button>

  {/* Any click closes it: on the photo, the button or the backdrop. */}
  <dialog
    class="m-auto max-h-none max-w-none overflow-visible rounded-photo bg-surface p-0 text-ink shadow-dialog backdrop:bg-overlay"
    aria-label={alt}
  >
    <figure
      class:list={[
        'grid cursor-zoom-out',
        caption
          ? 'w-[min(92vw,1200px,calc(80dvh*var(--ratio)))]'
          : 'w-[min(92vw,1200px,calc(88dvh*var(--ratio)))]',
      ]}
      style={`--ratio: ${src.width / src.height}`}
    >
      <Picture
        src={src}
        alt={alt}
        formats={formats}
        widths={[800, 1600]}
        sizes="min(92vw, 1200px)"
        loading="lazy"
        class:list={['h-auto w-full rounded-photo', caption && 'rounded-b-none']}
      />
      {caption && <figcaption class="px-4 py-3 text-ui/snug">{caption}</figcaption>}
    </figure>
    <button
      type="button"
      class="absolute top-2.5 right-2.5 grid size-9 place-items-center rounded-control bg-dark-card text-xl text-dark-card-ink"
      aria-label="Close"
    >
      ×
    </button>
  </dialog>
</pm-lightbox>

<script>
  import './pmLightbox';
</script>
