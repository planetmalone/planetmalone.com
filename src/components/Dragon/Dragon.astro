---
/**
 * The census-taking bearded dragon, peeking over the top edge of his
 * positioned parent (place him with `bottom-[calc(100%-6px)]`, so his claws
 * hook over it). <pm-dragon> (./pmDragon.ts) ducks him behind the edge while
 * he's out of view and pops him up when he's scrolled into it. Without JS he
 * just stays up. Decoration only, so hidden from screen readers.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<pm-dragon class:list={['group block', className]} aria-hidden="true">
  <svg class="block w-full overflow-visible" viewBox="0 0 96 60" focusable="false">
    <defs>
      {/* The parent's top edge: his head is hidden below it. */}
      <clipPath id="dragon-edge">
        <rect x="-10" y="-30" width="116" height="85"></rect>
      </clipPath>
    </defs>
    <g class="stroke-logo-outline" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <g clip-path="url(#dragon-edge)">
        {/* Pops up after the claws grab the edge, two seconds after he's in view; ducks first. */}
        <g class="transition-[translate] delay-2000 duration-500 ease-pop group-[[ducked]]:[translate:0_56px] group-[[ducked]]:delay-0 group-[[ducked]]:duration-200 group-[[ducked]]:ease-standard">
          {/*
            Facing left, chin up; the rest of him is behind the edge. A bearded dragon:
            a brow bump over a big eye, a fringe of spikes around the back of the head,
            an ear hole, and the pale, spiky beard under an open, smiling mouth.
          */}
          <g filter="url(#rough)">
            <path
              class="fill-dragon"
              d="M-3 12 C-3 9 3 8 9 8.5 C16 9 22 9 27 7 C31 2 40 2 43 7 C45 9.5 46.5 12 47 14 L55 9 L54 17 L63 14 L59 22 L69 21 L63 28 L73 29 L65 34 L75 38 L67 41 L75 48 L68 49 L72 64 L26 64 C18 50 4 30 -2 14 Z"
            />
            <path
              class="fill-dragon-belly"
              d="M1 20 C12 22 24 24.5 34 27 C40 28.5 44 32 46 37 L51 39 L47 43 L53 46 L47 49 L52 54 L46 56 L48 64 L26 64 C18 50 8 34 1 20 Z"
            />
            <path class="fill-dragon-mouth" d="M-2.5 14 C9 18 22 23 35 27 C23 25 11 22.5 1 20 Z" />
            <path
              class="fill-none stroke-logo-outline/40"
              stroke-width="1.3"
              d="M17 31 q2 2.5 4.5 3 M27 35 q2 2.5 4.5 3 M22 42 q2 2.5 4.5 3 M35 43 q2 2.5 4.5 3 M30 50 q2 2.5 4.5 3"
            />
            <ellipse class="fill-logo-outline" cx="56" cy="35" rx="2.6" ry="3" stroke-width="0" />
            <circle class="fill-logo-outline" cx="5" cy="10.5" r="1" stroke-width="0" />
          </g>
          {/* The eye stays crisp: the wobble would smudge it. */}
          <circle class="fill-paper" cx="35" cy="15" r="4.6" stroke-width="1.6" />
          <circle class="fill-logo-outline" cx="34" cy="15.4" r="2.5" stroke-width="0" />
          <circle class="fill-paper" cx="33.1" cy="14.3" r="0.85" stroke-width="0" />
        </g>
      </g>
      {/* Front claws, hooked over the edge */}
      <g
        class="transition-opacity delay-1900 duration-150 group-[[ducked]]:opacity-0 group-[[ducked]]:delay-150"
        filter="url(#rough)"
      >
        <path
          class="fill-dragon"
          d="M22 56 C22 50 26 47 31 48 C35 49 36 53 35 56 M78 56 C78 50 82 48 86 50 C89 52 89 54 88 57"
        />
        <path class="fill-none" d="M25 55 L24 59 M29 55 L29 60 M33 55 L34 59 M81 55 L80 59 M85 55 L85 60" />
      </g>
    </g>
  </svg>
</pm-dragon>

<script>
  import './pmDragon';
</script>
