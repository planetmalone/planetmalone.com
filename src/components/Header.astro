---
import LogoMark from './LogoMark.astro';
import ThemeIcon from './ThemeIcon.astro';
import { Button } from './Button';
import { SkipLink } from './SkipLink';
import { pages, sections, type PageKey } from '../data/site';

interface Props {
  current?: PageKey | undefined;
  /** Starts transparent over a full-screen hero, then turns to glass once the hero's horizon clears it. */
  overHero?: boolean;
}

const { current, overHero = false } = Astro.props;

const menuItems = [
  ...sections.map((s) => ({ label: s.label, href: `/#${s.id}`, current: false })),
  ...pages.filter((p) => p.key !== 'work').map((p) => ({ ...p, current: p.key === current })),
];
---

<SkipLink />

<header
  class:list={[
    // Glassmorphism: a faint white fill, heavy blur, a thin light edge and a soft shadow.
    'sticky top-0 z-20 border-b border-glass-edge bg-surface/20 text-ink shadow-glass backdrop-blur-xl backdrop-saturate-150 print:hidden',
    'transition-[background-color,border-color,box-shadow] duration-300 dark:bg-ink/6',
    '[@media(prefers-reduced-transparency:reduce)]:not-data-over-hero:bg-surface',
    // Over the hero: clear, with dark-theme colors so it reads on the navy.
    'data-over-hero:border-transparent data-over-hero:bg-transparent data-over-hero:shadow-none data-over-hero:backdrop-filter-none data-over-hero:scheme-dark',
  ]}
  data-over-hero={overHero ? '' : undefined}
  data-site-header
>
  <div class="mx-auto flex max-w-page items-center justify-between gap-3 px-gutter py-2.5">
    <a
      class="flex min-h-11 items-center gap-2.5 text-ink no-underline"
      href="/"
      aria-label="Planet Malone home"
    >
      <LogoMark size={32} id="brand" />
      <span class="font-display text-lg font-bold tracking-[-0.02em]">planet malone</span>
    </a>

    <div class="flex items-center gap-2">
      <nav class="mr-1.5 flex gap-1 text-ui font-semibold max-md:hidden" aria-label="Pages">
        {pages.map((p) => (
          <a
            class="rounded-pill px-3 py-2 text-ink no-underline hover:bg-sunken aria-[current=page]:bg-btn aria-[current=page]:text-btn-ink"
            href={p.href}
            aria-current={p.key === current ? 'page' : undefined}
          >
            {p.label}
          </a>
        ))}
      </nav>

      <Button
        variant="ghost"
        size="sm"
        bold={false}
        class="needs-js text-ink2"
        data-open-palette
        aria-keyshortcuts="Meta+K Control+K /"
      >
        <b class="text-ink">⌘K</b>
        {/* The visible text is the accessible name (WCAG 2.5.3); phones keep it for screen readers only. */}
        <span class="ml-1 max-md:sr-only">Search or do a thing</span>
      </Button>

      <button
        class="needs-js grid size-11 place-items-center rounded-full border bg-surface p-0 hover:border-ink"
        type="button"
        data-theme-toggle
        aria-label="Switch color theme"
      >
        <ThemeIcon size={22} />
      </button>

      <Button
        variant="ghost"
        size="sm"
        class="needs-js md:hidden"
        data-menu-open
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        Menu
      </Button>
    </div>
  </div>
</header>

<dialog
  class="glass fixed inset-x-3 top-18 bottom-auto m-0 w-auto max-w-none rounded-card p-2.5 text-ink shadow-menu backdrop:bg-overlay/50 print:hidden"
  id="site-menu"
  aria-label="Menu"
>
  <nav class="grid gap-0.5" aria-label="Menu">
    {menuItems.map((m) => (
      <a
        class="flex min-h-12 items-center rounded-box px-3.5 text-[17px] font-semibold text-ink no-underline hover:bg-sunken"
        href={m.href}
        aria-current={m.current ? 'page' : undefined}
      >
        {m.label}
      </a>
    ))}
  </nav>
</dialog>

<script>
  import { theme } from '../stores/theme';
  import { paletteOpen } from '../stores/palette';
  import { overHero } from '../stores/hero';
  import { toggleThemeFrom } from '../utils/themeReveal';

  // Over the home hero: the server marks it; the hero's horizon updates it once it knows.
  const header = document.querySelector<HTMLElement>('[data-site-header]')!;
  overHero.subscribe((over) => over !== undefined && header.toggleAttribute('data-over-hero', over));

  // Theme toggle: light ↔ dark, with a circular reveal from the click point.
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  theme.subscribe((t) => {
    themeBtn.ariaLabel = t === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
    themeBtn.title = themeBtn.ariaLabel;
  });

  themeBtn.addEventListener('click', (e) => {
    const box = themeBtn.getBoundingClientRect();
    // Keyboard clicks report 0,0; start from the button's center instead.
    toggleThemeFrom(e.clientX || box.left + box.width / 2, e.clientY || box.top + box.height / 2);
  });

  // Mobile menu: a modal <dialog>, which handles Esc, focus trapping and inert background.
  const menu = document.querySelector<HTMLDialogElement>('#site-menu')!;
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  menuBtn.addEventListener('click', () => {
    menu.showModal();
    menuBtn.ariaExpanded = 'true';
  });
  menu.addEventListener('close', () => (menuBtn.ariaExpanded = 'false'));
  // Clicks on the backdrop land on the dialog element itself.
  menu.addEventListener('click', (e) => {
    if (e.target === menu || (e.target as Element).closest('a')) menu.close();
  });

  document.querySelector('[data-open-palette]')!.addEventListener('click', () => paletteOpen.set(true));
  // Only one modal at a time: ⌘K from the open menu replaces it.
  paletteOpen.subscribe((open) => open && menu.close());
</script>
