---
import LogoMark from './LogoMark.astro';
import { Button } from './Button';
import { SkipLink } from './SkipLink';
import { pages, sections, type PageKey } from '../data/site';

interface Props {
  current?: PageKey | undefined;
}

const { current } = Astro.props;

const menuItems = [
  ...sections.map((s) => ({ label: s.label, href: `/#${s.id}`, current: false })),
  ...pages.filter((p) => p.key !== 'work').map((p) => ({ ...p, current: p.key === current })),
];
---

<SkipLink />

<header class="sticky top-0 z-20 border-b-1 bg-bg print:hidden">
  <div class="mx-auto flex max-w-page items-center justify-between gap-3 px-gutter py-2.5">
    <a
      class="flex min-h-11 items-center gap-2.5 text-ink no-underline"
      href="/"
      aria-label="Planet Malone home"
    >
      <LogoMark size={32} id="brand" />
      <span class="font-display text-lg font-bold tracking-[-0.02em]">planet malone</span>
    </a>

    <div class="flex items-center gap-2">
      <nav class="mr-1.5 flex gap-1 text-ui font-semibold max-md:hidden" aria-label="Pages">
        {pages.map((p) => (
          <a
            class="rounded-pill px-3 py-2 text-ink no-underline hover:bg-sunken aria-[current=page]:bg-sunken"
            href={p.href}
            aria-current={p.key === current ? 'page' : undefined}
          >
            {p.label}
          </a>
        ))}
      </nav>

      <Button
        variant="ghost"
        size="sm"
        bold={false}
        class="needs-js text-ink2"
        data-open-palette
        aria-label="Open command palette"
        aria-keyshortcuts="Meta+K Control+K /"
      >
        <b class="text-ink">⌘K</b>
        <span class="ml-1 max-md:hidden">Search or do a thing</span>
      </Button>

      <button
        class="needs-js grid size-11 place-items-center rounded-full border bg-surface p-0 hover:border-ink"
        type="button"
        data-theme-toggle
        aria-label="Switch color theme"
      >
        <LogoMark
          size={28}
          id="theme"
          class="transition-transform duration-300 ease-standard dark:-scale-x-100"
        />
      </button>

      <Button
        variant="ghost"
        size="sm"
        class="needs-js md:hidden"
        data-menu-open
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        Menu
      </Button>
    </div>
  </div>
</header>

<dialog
  class="fixed inset-x-3 top-18 bottom-auto m-0 w-auto max-w-none rounded-card bg-surface p-2.5 text-ink shadow-menu backdrop:bg-overlay print:hidden"
  id="site-menu"
  aria-label="Menu"
>
  <nav class="grid gap-0.5" aria-label="Menu">
    {menuItems.map((m) => (
      <a
        class="flex min-h-12 items-center rounded-box px-3.5 text-[17px] font-semibold text-ink no-underline hover:bg-sunken"
        href={m.href}
        aria-current={m.current ? 'page' : undefined}
      >
        {m.label}
      </a>
    ))}
  </nav>
</dialog>

<script>
  import { theme, themePref } from '../stores/theme';
  import { paletteOpen } from '../stores/palette';
  import { withViewTransition } from '../utils/viewTransition';

  // Theme toggle: light ↔ dark, with a circular reveal from the click point.
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  theme.subscribe((t) => {
    themeBtn.ariaLabel = t === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
    themeBtn.title = themeBtn.ariaLabel;
  });

  themeBtn.addEventListener('click', (e) => {
    const next = theme.get() === 'dark' ? 'light' : 'dark';
    const box = themeBtn.getBoundingClientRect();
    // Keyboard clicks report 0,0; start from the button's center instead.
    const x = e.clientX || box.left + box.width / 2;
    const y = e.clientY || box.top + box.height / 2;
    const vt = withViewTransition(() => themePref.set(next), 'pm-theme');
    vt?.ready.then(() => {
      const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      document.documentElement.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
        { duration: 450, easing: 'cubic-bezier(.4,0,.2,1)', pseudoElement: '::view-transition-new(root)' },
      );
    });
  });

  // Mobile menu: a modal <dialog>, which handles Esc, focus trapping and inert background.
  const menu = document.querySelector<HTMLDialogElement>('#site-menu')!;
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  menuBtn.addEventListener('click', () => {
    menu.showModal();
    menuBtn.ariaExpanded = 'true';
  });
  menu.addEventListener('close', () => (menuBtn.ariaExpanded = 'false'));
  // Clicks on the backdrop land on the dialog element itself.
  menu.addEventListener('click', (e) => {
    if (e.target === menu || (e.target as Element).closest('a')) menu.close();
  });

  // The palette itself arrives in Phase 4 and subscribes to this store.
  document.querySelector('[data-open-palette]')!.addEventListener('click', () => paletteOpen.set(true));
</script>
