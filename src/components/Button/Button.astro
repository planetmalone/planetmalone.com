---
/**
 * A pill button, or a link styled as one when `href` is set. Every other
 * attribute (data-*, aria-*, class) passes through to the element.
 *
 *   <Button variant="dark-outline" href="/resume-staff.pdf">Résumé · Staff</Button>
 *   <Button variant="ghost" size="sm" data-open-palette>⌘K</Button>
 */
import type { HTMLAttributes } from 'astro/types';

type Variant = 'ghost' | 'field' | 'field-outline' | 'accent' | 'dark-outline';

type Size = 'sm' | 'md' | 'lg';

type Props = (HTMLAttributes<'a'> | HTMLAttributes<'button'>) & {
  variant: Variant;
  size?: Size;
  href?: string;
  bold?: boolean;
};

const { variant, size = 'md', href, bold = true, class: className, ...attrs } = Astro.props;

const base = 'inline-flex items-center justify-center gap-1 rounded-pill no-underline';

const variants: Record<Variant, string> = {
  ghost: 'border bg-transparent hover:border-ink', // Text color inherits, so callers can set it
  field: 'bg-on-field text-field-btn-ink',
  'field-outline': 'border border-on-field bg-transparent text-on-field',
  accent: 'bg-c-accent text-c-accent-ink',
  'dark-outline': 'border border-dark-card-line bg-transparent text-dark-card-ink hover:border-c-accent',
};

const sizes: Record<Size, string> = {
  sm: 'min-h-11 px-3.5 text-sm',
  md: 'min-h-11 px-4.5',
  lg: 'min-h-11.5 px-5',
};

const classes = [base, variants[variant], sizes[size], bold && 'font-bold', className];
---

{href ? (
  <a class:list={classes} href={href} {...(attrs as HTMLAttributes<'a'>)}>
    <slot />
  </a>
) : (
  <button class:list={classes} type="button" {...(attrs as HTMLAttributes<'button'>)}>
    <slot />
  </button>
)}
